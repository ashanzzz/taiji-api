# Generate each secret separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROXY_API_KEY=replace-with-a-random-relay-key
ADMIN_KEY=replace-with-a-different-random-admin-key
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Set to true when the admin site is served over HTTPS.
SECURE_COOKIES=false
# Docker port binding. Set your LAN IP explicitly to allow LAN access.
BIND_ADDRESS=127.0.0.1
# Optional bootstrap. You can enter the account and password in the admin console instead.
TAIJI_ACCOUNT=
TAIJI_PASSWORD=
TAIJI_PUBLIC_URL=https://www.taijiai666.com/
TAIJI_ORIGIN=
DEFAULT_MODEL=openai::gpt-6-astra
TAIJI_APP_VERSION=3.4.0
REQUEST_TIMEOUT_MS=180000
